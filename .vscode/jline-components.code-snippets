  "c-mv (Main Visual Banner)": {
    "prefix": "c-mv",
    "body": [
      "<section class=\"c-mv\">",
      "\t<figure class=\"c-mv__bg\">",
      "\t\t<img src=\"${1:../assets/images/common/img_dummy.webp}\" alt=\"${2:}\">",
      "\t</figure>",
      "\t<div class=\"l-container\">",
      "\t\t<div class=\"c-mv__inner\">",
      "\t\t\t<h1 class=\"c-mv-title\">",
      "\t\t\t\t<span class=\"c-mv-title__en\">${3:TITLE}</span>",
      "\t\t\t\t<span class=\"c-mv-title__jp\">${4:タイトル}</span>",
      "\t\t\t</h1>",
      "\t\t</div>",
      "\t</div>",
      "</section>"
    ],
    "description": "FLOCSS Main Visual Banner (component/_mv.scss)"
  },
  "c-bread (Breadcrumb Navigation)": {
    "prefix": "c-bread",
    "body": [
      "<div class=\"l-container\">",
      "\t<ul class=\"c-bread\">",
      "\t\t<li class=\"c-bread__item\">",
      "\t\t\t<a href=\"${1:../}\" class=\"c-bread__link\">top</a>",
      "\t\t</li>",
      "\t\t<li class=\"c-bread__item\">${2:現在のページ}</li>",
      "\t</ul>",
      "</div>"
    ],
    "description": "FLOCSS Breadcrumbs (component/_bread.scss)"
  },
  "c-loading (Loading Spinner)": {
    "prefix": "c-loading",
    "body": [
      "<div class=\"c-loading\">",
      "\t<div class=\"c-loading__inner\">",
      "\t\t<div class=\"c-loading__content\">",
      "\t\t\t<div class=\"c-loading__item\"></div>",
      "\t\t\t<div class=\"c-loading__item\"></div>",
      "\t\t</div>",
      "\t</div>",
      "</div>"
    ],
    "description": "FLOCSS Page Loading Animation (component/_loading.scss)"
  }
}
