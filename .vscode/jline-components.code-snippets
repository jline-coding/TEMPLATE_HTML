  "c-title (EN/JP Bilingual Heading)": {
    "prefix": "c-title",
    "body": [
      "<h2 class=\"c-title\">",
      "\t<span class=\"c-title__en\">${1:ENGLISH TITLE}</span>",
      "\t<span class=\"c-title__jp\">${2:日本語タイトル}</span>",
      "</h2>"
    ],
    "description": "FLOCSS Bilingual Title EN/JP (component/_titles.scss)"
  },
  "c-ttl (Heading with Custom Size)": {
    "prefix": "c-ttl",
    "body": [
      "<h2 class=\"c-ttl${1|36,34,32,30,28,26,24,22,20,18,16|}\">${2:タイトルコンテンツ}</h2>"
    ],
    "description": "FLOCSS Heading with selectable font-size"
  },
  "c-ttl36--line (Heading with Underline)": {
    "prefix": "c-ttl36-line",
    "body": [
      "<h2 class=\"c-ttl36 c-ttl36--line\">${1:タイトルコンテンツ}</h2>"
    ],
    "description": "FLOCSS Heading 36px with line accent"
  },
  "c-ttl36--dot (Heading with Dot Accent)": {
    "prefix": "c-ttl36-dot",
    "body": [
      "<h2 class=\"c-ttl36 c-ttl36--dot\">${1:タイトルコンテンツ}</h2>"
    ],
    "description": "FLOCSS Heading 36px with dot accent"
  },
  "c-txt (Text Paragraph)": {
    "prefix": "c-txt",
    "body": [
      "<p class=\"c-txt${1|16,14,12,18,20,22,24|}\">${2:ダミーテキスト。ダミーテキスト。}</p>"
    ],
    "description": "FLOCSS Paragraph Text with selectable font-size (component/_texts.scss)"
  },
  "c-link (Standard Link)": {
    "prefix": "c-link",
    "body": [
      "<a href=\"${1:#}\" class=\"c-link\">${2:リンク}</a>"
    ],
    "description": "FLOCSS Standard Link (component/_links.scss)"
  },
  "c-link--blank (External Link)": {
    "prefix": "c-link-blank",
    "body": [
      "<a href=\"${1:#}\" class=\"c-link c-link--blank\" target=\"_blank\" rel=\"noopener noreferrer\">${2:リンク}</a>"
    ],
    "description": "FLOCSS External Link with icon"
  },
  "l-grid (2 Columns Grid)": {
    "prefix": "l-grid",
    "body": [
      "<div class=\"l-grid\">",
      "\t<div class=\"l-grid__item\">",
      "\t\t<figure>",
      "\t\t\t<img src=\"${1:./assets/images/common/img_dummy.webp}\" alt=\"${2:}\">",
      "\t\t</figure>",
      "\t</div>",
      "\t<div class=\"l-grid__item\">",
      "\t\t<figure>",
      "\t\t\t<img src=\"${3:./assets/images/common/img_dummy.webp}\" alt=\"${4:}\">",
      "\t\t</figure>",
      "\t</div>",
      "</div>"
    ],
    "description": "FLOCSS 2-Column Grid (layout/_grids.scss)"
  },
  "l-grid--cl3 (3 Columns Grid)": {
    "prefix": "l-grid3",
    "body": [
      "<div class=\"l-grid l-grid--cl3\">",
      "\t<div class=\"l-grid__item\">",
      "\t\t<figure><img src=\"${1:./assets/images/common/img_dummy.webp}\" alt=\"${2:}\"></figure>",
      "\t</div>",
      "\t<div class=\"l-grid__item\">",
      "\t\t<figure><img src=\"${3:./assets/images/common/img_dummy.webp}\" alt=\"${4:}\"></figure>",
      "\t</div>",
      "\t<div class=\"l-grid__item\">",
      "\t\t<figure><img src=\"${5:./assets/images/common/img_dummy.webp}\" alt=\"${6:}\"></figure>",
      "\t</div>",
      "</div>"
    ],
    "description": "FLOCSS 3-Column Grid (layout/_grids.scss)"
  },
  "l-grid--cl4 (4 Columns Grid)": {
    "prefix": "l-grid4",
    "body": [
      "<div class=\"l-grid l-grid--cl4\">",
      "\t<div class=\"l-grid__item\">",
      "\t\t<figure><img src=\"${1:./assets/images/common/img_dummy.webp}\" alt=\"${2:}\"></figure>",
      "\t</div>",
      "\t<div class=\"l-grid__item\">",
      "\t\t<figure><img src=\"${3:./assets/images/common/img_dummy.webp}\" alt=\"${4:}\"></figure>",
      "\t</div>",
      "\t<div class=\"l-grid__item\">",
      "\t\t<figure><img src=\"${5:./assets/images/common/img_dummy.webp}\" alt=\"${6:}\"></figure>",
      "\t</div>",
      "\t<div class=\"l-grid__item\">",
      "\t\t<figure><img src=\"${7:./assets/images/common/img_dummy.webp}\" alt=\"${8:}\"></figure>",
      "\t</div>",
      "</div>"
    ],
    "description": "FLOCSS 4-Column Grid (layout/_grids.scss)"
  },
  "l-flex (2 Columns Flex Left/Right)": {
    "prefix": "l-flex",
    "body": [
      "<div class=\"l-flex${1| , l-flex--middle, l-flex--reverse, l-flex--reverse l-flex--middle, l-flex--center, l-flex--center l-flex--middle|}\">",
      "\t<div class=\"l-flex__left\">",
      "\t\t<figure>",
      "\t\t\t<img src=\"${2:./assets/images/common/img_dummy.webp}\" alt=\"${3:}\">",
      "\t\t</figure>",
      "\t</div>",
      "\t<div class=\"l-flex__right\">",
      "\t\t<h2 class=\"c-ttl24\">${4:タイトル}</h2>",
      "\t\t<p class=\"c-txt16\">${5:ダミーテキスト。ダミーテキスト。}</p>",
      "\t</div>",
      "</div>"
    ],
    "description": "FLOCSS 2-Column Flex (layout/_flexs.scss)"
  },
  "l-tbl (Table Item Definition)": {
    "prefix": "l-tbl",
    "body": [
      "<div class=\"l-tbl\">",
      "\t<div class=\"l-tbl__item${1| , l-tbl__item--middle|}\">",
      "\t\t<div class=\"l-tbl__left\">",
      "\t\t\t<h2 class=\"c-ttl16\">${2:項目名}</h2>",
      "\t\t</div>",
      "\t\t<div class=\"l-tbl__right\">",
      "\t\t\t<p class=\"c-txt16\">${3:ダミーテキスト。ダミーテキスト。}</p>",
      "\t\t</div>",
      "\t</div>",
      "\t<div class=\"l-tbl__item${1| , l-tbl__item--middle|}\">",
      "\t\t<div class=\"l-tbl__left\">",
      "\t\t\t<h2 class=\"c-ttl16\">${4:項目名}</h2>",
      "\t\t</div>",
      "\t\t<div class=\"l-tbl__right\">",
      "\t\t\t<p class=\"c-txt16\">${5:ダミーテキスト。ダミーテキスト。}</p>",
      "\t\t</div>",
      "\t</div>",
      "</div>"
    ],
    "description": "FLOCSS Table List (layout/_tbls.scss)"
  },
  "c-list-dot (Dot List)": {
    "prefix": "c-list-dot",
    "body": [
      "<ul class=\"c-list-dot\">",
      "\t<li class=\"c-list-dot__item\">${1:ダミーテキスト。}</li>",
