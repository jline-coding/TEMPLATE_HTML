{
  "c-btn (Standard Button)": {
    "prefix": "c-btn",
    "body": [
      "<a href=\"${1:#}\" class=\"c-btn\">",
      "\t<span class=\"c-btn__content\">${2:ボタン}</span>",
      "</a>"
    ],
    "description": "FLOCSS Standard Button (component/_btn.scss)"
  },
  "c-btn--arrow (Button with Arrow)": {
    "prefix": "c-btn-arrow",
    "body": [
      "<a href=\"${1:#}\" class=\"c-btn c-btn--arrow\">",
      "\t<span class=\"c-btn__content\">${2:ボタン}</span>",
      "</a>"
    ],
    "description": "FLOCSS Button with Right Arrow"
  },
