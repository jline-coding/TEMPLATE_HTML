/node_modules

# Thư mục thử nghiệm nội bộ trong public (không bàn giao cho khách)
/public/__workbench/

# Source maps (chỉ dùng khi dev debug, không commit lên repo)
*.map

# File rác hệ điều hành (Chống lọt vào WinMerge khi phía Nhật kiểm tra)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Deploy artifacts (generated on CI)
.repo_lock
.htpasswd
.htaccess
.deploy_sha
.deploy_manifest.json
.env
.env.*
!.env.example

# Workbench backups
workbench/.backup/
workbench__backup/
workbench_backup/
workbench copy/
scratch/

# VS Code (Whitelist shared configs & extension source, ignore temp files)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/*.code-snippets
!.vscode/extension/
.vscode/.temp*
