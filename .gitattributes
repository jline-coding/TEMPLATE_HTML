# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Code and configuration files (Strict LF)
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.scss text eol=lf
*.css text eol=lf
*.ejs text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.cgi text eol=lf
*.pm text eol=lf
*.tpl text eol=lf

# Binary files (No line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.mp4 binary
*.ogg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.vsix binary
*.pdf binary
