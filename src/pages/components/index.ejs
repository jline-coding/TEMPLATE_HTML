<script>
/* ==========================================================================
   AUTO-CONVERT INCLUDED FILES INTO MODULAR CARDS
   - Parses directly from included _*.ejs files
   - Edit partial files and this showcase updates dynamically!
   ========================================================================== */
(function() {
    let toastTimeout = null;

    window.showToast = function(msg) {
        const toast = document.getElementById('cs-toast');
        const toastMsg = document.getElementById('cs-toast-msg');
        if (!toast || !toastMsg) return;
        toastMsg.textContent = msg;
        toast.classList.add('is-show');
        if (toastTimeout) clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => {
            toast.classList.remove('is-show');
        }, 2200);
    };

    window.copyRaw = function(text) {
        if (!text) return;
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(() => {
                showToast(`Copied class: ".${text}"`);
            });
        }
    };

    window.copySnippetFromCard = function(btn) {
        const card = btn.closest('.cs-card');
        if (!card) return;
        const codeBlock = card.querySelector('.cs-card__code pre code');
        let htmlToCopy = '';
        if (codeBlock) {
            htmlToCopy = codeBlock.textContent.trim();
        } else {
            const preview = card.querySelector('.cs-card__preview');
            if (preview) htmlToCopy = preview.innerHTML.trim();
        }

        if (htmlToCopy) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(htmlToCopy).then(() => {
                    showToast('Copied HTML snippet to clipboard!');
                });
            } else {
                const ta = document.createElement('textarea');
                ta.value = htmlToCopy;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                showToast('Copied HTML snippet to clipboard!');
            }

            const originalText = btn.innerHTML;
            btn.innerHTML = '✅ Copied!';
            btn.style.background = '#10b981';
            setTimeout(() => {
                btn.innerHTML = originalText;
                btn.style.background = '';
            }, 1200);
        }
    };

    window.toggleCodeAccordion = function(btn) {
        const card = btn.closest('.cs-card');
        if (!card) return;
        const code = card.querySelector('.cs-card__code');
        if (!code) return;
        code.classList.toggle('is-open');
        btn.textContent = code.classList.contains('is-open') ? 'Hide Code' : 'Code';
    };

    // Helper to build dynamic Card element
    function buildCard(el, title, classTag, isFull = false, isDark = false, isLeft = false) {
        const card = document.createElement('div');
        card.className = 'cs-card';
        card.setAttribute('data-search', `${title} ${classTag}`.toLowerCase());

        // Escape HTML for code block
        const cleanHtml = el.outerHTML;
        const escaped = cleanHtml
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');

        card.innerHTML = `
            <div class="cs-card__toolbar">
                <span class="cs-card__title">${title} <span class="cs-card__class-tag">.${classTag}</span></span>
                <div class="cs-card__actions">
                    <button type="button" class="cs-btn-action cs-btn-action--copy" onclick="copySnippetFromCard(this)">📋 Copy HTML</button>
                    <button type="button" class="cs-btn-action cs-btn-action--secondary" onclick="copyRaw('${classTag}')">Class</button>
                    <button type="button" class="cs-btn-action cs-btn-action--secondary" onclick="toggleCodeAccordion(this)">Code</button>
                </div>
            </div>
            <div class="cs-card__preview ${isDark ? 'cs-card__preview--dark' : ''} ${isLeft ? 'cs-card__preview--left' : ''}"></div>
            <div class="cs-card__code">
                <pre><code>${escaped}</code></pre>
            </div>
        `;

        card.querySelector('.cs-card__preview').appendChild(el);
        return card;
    }

    // Transform included content blocks into individual Cards
    function transformSections() {
        const sections = document.querySelectorAll('.cs-section');

        sections.forEach(sec => {
            const title = sec.getAttribute('data-title') || '';
            const file = sec.getAttribute('data-file') || '';
            const type = sec.getAttribute('data-type') || 'single';
            const raw = sec.querySelector('.cs-raw-content');
            if (!raw) return;

            // Create Section Header
            const header = document.createElement('div');
            header.className = 'cs-section__header';
            header.innerHTML = `
                <h2 class="cs-section__title">${title}</h2>
                <span class="cs-section__file">📁 ${file}</span>
            `;

            const isFull = true;
            const gridCards = document.createElement('div');
            gridCards.className = 'cs-grid-cards cs-grid-cards--full';

            if (type === 'single') {
                const child = raw.firstElementChild;
                if (child) {
                    const tag = child.className || child.tagName.toLowerCase();
                    const card = buildCard(child, title, tag, true, false, true);
                    gridCards.appendChild(card);
                }
            } else if (type === 'btns') {
                const buttons = Array.from(raw.querySelectorAll('a.c-btn'));
                buttons.forEach((btn, idx) => {
                    const cls = btn.className;
                    const isDark = cls.includes('--reverse');
                    let name = `Button #${idx + 1}`;
                    if (cls.includes('--arrow-between')) name = 'Button Arrow Between';
                    else if (cls.includes('--arrow-center')) name = 'Button Arrow Center';
                    else if (cls.includes('--arrow')) name = 'Button with Arrow';
                    else if (cls.includes('--reverse')) name = 'Button Reverse';
                    else name = 'Button Standard';

                    if (isDark && !name.includes('Reverse')) name += ' (Reverse)';
                    const card = buildCard(btn, name, cls, false, isDark, false);
                    gridCards.appendChild(card);
                });
            } else if (type === 'titles') {
                const titles = Array.from(raw.querySelectorAll('.c-title, [class*="c-ttl"]'));
                titles.forEach(ttl => {
                    const cls = ttl.className;
                    let name = 'Heading';
                    if (cls.includes('c-title')) name = 'Bilingual Title EN/JP';
                    else if (cls.includes('--line')) name = 'Heading 36px Line';
                    else if (cls.includes('--dot')) name = 'Heading 36px Dot';
                    else {
                        const m = cls.match(/c-ttl(\d+)/);
                        name = m ? `Heading ${m[1]}px` : 'Heading';
                    }
                    const card = buildCard(ttl, name, cls, false, false, true);
                    gridCards.appendChild(card);
                });
            } else if (type === 'texts') {
                const texts = Array.from(raw.querySelectorAll('[class*="c-txt"]'));
                texts.forEach(txt => {
                    const cls = txt.className;
                    const m = cls.match(/c-txt(\d+)/);
                    const name = m ? `Text ${m[1]}px` : 'Paragraph';
                    const card = buildCard(txt, name, cls, false, false, true);
                    gridCards.appendChild(card);
                });
            } else if (type === 'links') {
                const links = Array.from(raw.querySelectorAll('a.c-link'));
                links.forEach(lnk => {
                    const cls = lnk.className;
                    const isBlank = cls.includes('--blank');
                    const name = isBlank ? 'External Link (Blank)' : 'Standard Link';
                    const card = buildCard(lnk, name, cls, false, false, true);
                    gridCards.appendChild(card);
                });
            } else if (type === 'grids') {
                const grids = Array.from(raw.querySelectorAll('.l-grid'));
                grids.forEach((grd, idx) => {
                    const cls = grd.className;
                    let name = '2 Columns Grid';
                    if (cls.includes('--cl3')) name = '3 Columns Grid';
                    else if (cls.includes('--cl4')) name = '4 Columns Grid';
                    const card = buildCard(grd, name, cls, true, false, false);
                    gridCards.appendChild(card);
                });
            } else if (type === 'flexs') {
                const flexWrappers = Array.from(raw.querySelectorAll('.l-container, .l-flex'));
                const items = [];
                flexWrappers.forEach(el => {
                    if (el.classList.contains('l-container') && el.querySelector('.l-flex')) {
                        items.push(el);
                    } else if (el.classList.contains('l-flex') && !el.closest('.l-container')) {
                        items.push(el);
                    }
                });
                items.forEach((item, idx) => {
                    const flx = item.classList.contains('l-flex') ? item : item.querySelector('.l-flex');
                    const cls = flx ? flx.className : item.className;
                    let name = `Flex #${idx + 1}`;
                    if (cls.includes('--center') && cls.includes('--reverse') && cls.includes('--middle')) name = 'Flex Center + Reverse + Middle';
                    else if (cls.includes('--center') && cls.includes('--middle')) name = 'Flex Center + Middle';
                    else if (cls.includes('--center') && cls.includes('--reverse')) name = 'Flex Center + Reverse';
                    else if (cls.includes('--center')) name = 'Flex Center';
                    else if (cls.includes('--reverse') && cls.includes('--middle')) name = 'Flex Reverse + Middle';
                    else if (cls.includes('--middle')) name = 'Flex Middle';
                    else if (cls.includes('--reverse')) name = 'Flex Reverse';
                    else name = 'Flex Standard';

                    const card = buildCard(item, name, cls, true, false, false);
                    gridCards.appendChild(card);
                });
            } else if (type === 'tables') {
                const tables = Array.from(raw.querySelectorAll('.l-tbl'));
                tables.forEach((tbl, idx) => {
                    const hasMiddle = tbl.querySelector('.l-tbl__item--middle');
                    const name = hasMiddle ? 'Table List Middle (Vertical Center)' : 'Table List Standard';
                    const cls = hasMiddle ? 'l-tbl .l-tbl__item--middle' : 'l-tbl';
                    const card = buildCard(tbl, name, cls, true, false, false);
                    gridCards.appendChild(card);
                });
            } else if (type === 'lists') {
                const lists = Array.from(raw.querySelectorAll('ul[class*="c-list"]'));
                lists.forEach(lst => {
                    const cls = lst.className;
                    let name = 'List';
                    if (cls.includes('-dot')) name = 'Bullet List (Dot)';
                    else if (cls.includes('-number')) name = 'Numbered List';
                    else if (cls.includes('-star')) name = 'Star Bullet List';
                    const card = buildCard(lst, name, cls, true, false, true);
                    gridCards.appendChild(card);
                });
            }

            // Remove raw container and append header + cards
            raw.remove();
            sec.appendChild(header);
            sec.appendChild(gridCards);
        });
    }

    // Execute transformation
    transformSections();

    // Live Search
    const searchInput = document.getElementById('cs-filter-input');
    if (searchInput) {
        searchInput.addEventListener('input', function(e) {
            const val = e.target.value.toLowerCase().trim();
            const cards = document.querySelectorAll('.cs-card');
            const sections = document.querySelectorAll('.cs-section');

            cards.forEach(card => {
                const text = card.textContent.toLowerCase();
                const searchMeta = (card.getAttribute('data-search') || '').toLowerCase();
                if (text.includes(val) || searchMeta.includes(val)) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });

            sections.forEach(sec => {
                const visible = sec.querySelectorAll('.cs-card:not([style*="display: none"])');
                sec.style.display = (visible.length === 0 && val !== '') ? 'none' : '';
            });
        });
    }

    // Highlight active sidebar link on scroll
    const navLinks = document.querySelectorAll('.cs-nav__link');
    const sections = document.querySelectorAll('.cs-section');

    window.addEventListener('scroll', () => {
        let current = '';
        const scrollPos = window.scrollY + 80;
        sections.forEach(section => {
            const top = section.offsetTop;
            const height = section.offsetHeight;
            if (scrollPos >= top && scrollPos < top + height) {
                current = '#' + section.getAttribute('id');
            }
        });

        navLinks.forEach(link => {
            link.classList.remove('is-active');
            if (link.getAttribute('href') === current) {
                link.classList.add('is-active');
            }
        });
    });
})();
</script>
