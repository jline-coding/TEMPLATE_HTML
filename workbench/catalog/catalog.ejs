<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Workbench Component Library & Design System</title>
  <link rel="stylesheet" href="./catalog.css">
  <link rel="stylesheet" href="./workbench.css">
  <!-- Site Fonts (Auto-inherited from site layout) -->
  <%- siteFontLinks %>
  <script src="../assets/vendor/jquery/jquery-4.0.0.min.js" defer></script>
  <script src="../assets/js/inview.js" defer></script>
  <script src="../assets/js/common.js" defer></script>
  <script src="./catalog.js" defer></script>
  <script src="./components.js" defer></script>
</head>
<body>

<div class="cs-app">
    <!-- =======================================================
         FIXED SIDEBAR: GROUPED BY HEADER, FOOTER, LAYOUT, COMPONENT
         ======================================================= -->
    <aside class="cs-sidebar">
        <div class="cs-sidebar__header">
            <div class="cs-brand">
                <div class="cs-brand__icon">⚡</div>
                <div>
                    <div class="cs-brand__text">DEV WORKBENCH</div>
                    <div class="cs-brand__sub">Design System & Component Registry</div>
                </div>
            </div>
            <div class="cs-search">
                <span class="cs-search__icon">🔍</span>
                <input type="text" id="cs-filter-input" class="cs-search__input" placeholder="Lọc component..." autocomplete="off">
            </div>
            <!-- Quick Filter Tabs -->
            <div class="cs-cat-tabs">
                <button type="button" class="cs-cat-tab is-active" data-cat="all" onclick="filterCategory('all', this)">Tất cả</button>
                <button type="button" class="cs-cat-tab" data-cat="header" onclick="filterCategory('header', this)">🧭 Header</button>
                <button type="button" class="cs-cat-tab" data-cat="footer" onclick="filterCategory('footer', this)">⚓ Footer</button>
                <button type="button" class="cs-cat-tab" data-cat="layout" onclick="filterCategory('layout', this)">📐 Layout</button>
                <button type="button" class="cs-cat-tab" data-cat="component" onclick="filterCategory('component', this)">🧩 Components</button>
            </div>
        </div>

        <nav class="cs-nav">
            <% 
              const comps = typeof componentModules !== 'undefined' ? componentModules : [];
              const headerComps = comps.filter(c => c.category === 'header');
              const footerComps = comps.filter(c => c.category === 'footer');
              const layoutComps = comps.filter(c => c.category === 'layout');
              const uiComps = comps.filter(c => c.category === 'component');
              let globalIdx = 1;
            %>

            <!-- 1. Header Group -->
            <% if (headerComps.length > 0) { %>
            <div class="cs-nav__group" data-nav-group="header">
                <div class="cs-nav__group-title">
                    <span>🧭 Header (<%= headerComps.length %>)</span>
                    <span class="cs-nav__group-badge">header</span>
                </div>
                <ul class="cs-nav__list">
                    <% headerComps.forEach(comp => { %>
                    <li data-nav-item="<%= comp.name %>">
                        <a href="#sec-<%= comp.name %>" class="cs-nav__link">
                            <span style="display:flex;align-items:center;gap:6px;">
                                <span class="cs-nav__status-dot <%= comp.isInstalled ? 'is-installed' : '' %>" id="dot-<%= comp.name %>"></span>
                                <span><%= comp.title %></span>
                            </span>
                            <span class="cs-nav__badge"><%= comp.file %></span>
                        </a>
                    </li>
                    <% }); %>
                </ul>
            </div>
            <% } %>

            <!-- 2. Footer Group -->
            <% if (footerComps.length > 0) { %>
            <div class="cs-nav__group" data-nav-group="footer">
                <div class="cs-nav__group-title">
                    <span>⚓ Footer (<%= footerComps.length %>)</span>
                    <span class="cs-nav__group-badge">footer</span>
                </div>
                <ul class="cs-nav__list">
                    <% footerComps.forEach(comp => { %>
                    <li data-nav-item="<%= comp.name %>">
                        <a href="#sec-<%= comp.name %>" class="cs-nav__link">
                            <span style="display:flex;align-items:center;gap:6px;">
                                <span class="cs-nav__status-dot <%= comp.isInstalled ? 'is-installed' : '' %>" id="dot-<%= comp.name %>"></span>
                                <span><%= comp.title %></span>
                            </span>
                            <span class="cs-nav__badge"><%= comp.file %></span>
                        </a>
                    </li>
                    <% }); %>
                </ul>
            </div>
            <% } %>

            <!-- 3. Layout Group -->
            <% if (layoutComps.length > 0) { %>
            <div class="cs-nav__group" data-nav-group="layout">
                <div class="cs-nav__group-title">
                    <span>📐 Layout & Structure (<%= layoutComps.length %>)</span>
                    <span class="cs-nav__group-badge">layout</span>
                </div>
                <ul class="cs-nav__list">
                    <% layoutComps.forEach(comp => { %>
                    <li data-nav-item="<%= comp.name %>">
                        <a href="#sec-<%= comp.name %>" class="cs-nav__link">
                            <span style="display:flex;align-items:center;gap:6px;">
                                <span class="cs-nav__status-dot <%= comp.isInstalled ? 'is-installed' : '' %>" id="dot-<%= comp.name %>"></span>
                                <span><%= comp.title %></span>
                            </span>
                            <span class="cs-nav__badge"><%= comp.file %></span>
                        </a>
                    </li>
                    <% }); %>
                </ul>
            </div>
            <% } %>

            <!-- 4. UI Components Group -->
            <% if (uiComps.length > 0) { %>
            <div class="cs-nav__group" data-nav-group="component">
                <div class="cs-nav__group-title">
                    <span>🧩 UI Components (<%= uiComps.length %>)</span>
                    <span class="cs-nav__group-badge">c-*</span>
                </div>
                <ul class="cs-nav__list">
                    <% uiComps.forEach(comp => { %>
                    <li data-nav-item="<%= comp.name %>">
                        <a href="#sec-<%= comp.name %>" class="cs-nav__link">
                            <span style="display:flex;align-items:center;gap:6px;">
                                <span class="cs-nav__status-dot <%= comp.isInstalled ? 'is-installed' : '' %>" id="dot-<%= comp.name %>"></span>
                                <span><%= comp.title %></span>
                            </span>
                            <span class="cs-nav__badge"><%= comp.file %></span>
                        </a>
                    </li>
                    <% }); %>
                </ul>
            </div>
            <% } %>
        </nav>

        <div class="cs-sidebar__footer">
            💡 <strong>1-Click Web Import:</strong><br>
            Bấm nút <strong>[🚀 Import vào Site]</strong> trên từng component để tự động đưa toàn bộ HTML, SCSS &amp; JS vào site chính.<br>
            Hoặc dùng CLI: <code>npm run add &lt;name&gt;</code>
        </div>
    </aside>

    <!-- =======================================================
         MAIN WORKSPACE: FULL WIDTH & DYNAMIC MODULAR INCLUDES
         ======================================================= -->
    <main class="cs-main">
        <header class="cs-topbar">
            <div>
                <h1 class="cs-topbar__title">Workbench Component Catalog</h1>
                <p class="cs-topbar__desc">Kho mẫu chuẩn độc lập dành cho dev. Xem trước trực quan, 1-click import chuẩn xác vào site chính.</p>
            </div>
            <div class="cs-topbar__controls">
                <div class="cs-viewport-switcher">
                    <button type="button" class="cs-viewport-btn is-active" onclick="setViewport('desktop', this)">💻 Desktop</button>
                    <button type="button" class="cs-viewport-btn" onclick="setViewport('tablet', this)">📱 Tablet 768px</button>
                    <button type="button" class="cs-viewport-btn" onclick="setViewport('mobile', this)">📱 Mobile 375px</button>
                </div>
                <div class="cs-stat-pill">Modules: <strong><%= comps.length %></strong></div>
                <div class="cs-stat-pill" id="cs-installed-stat">Đã cài vào site: <strong>...</strong></div>
            </div>
        </header>

        <div id="cs-viewport-container" class="cs-viewport-wrapper">
            <% comps.forEach((comp, idx) => { %>
            <section id="sec-<%= comp.name %>" class="cs-section" 
                     data-name="<%= comp.name %>" 
                     data-title="<%= comp.title %>" 
                     data-file="<%= comp.file %>"
                     data-cat="<%= comp.category %>"
                     data-installed="<%= comp.isInstalled ? 'true' : 'false' %>">
                <textarea class="cs-raw-ejs" style="display:none;"><%= comp.rawContent %></textarea>
                <% if (comp.scssContent) { %>
                <textarea class="cs-raw-scss" style="display:none;"><%= comp.scssContent %></textarea>
                <% } %>
                <% if (comp.jsContent) { %>
                <textarea class="cs-raw-js" style="display:none;"><%= comp.jsContent %></textarea>
                <% } %>
                <div class="cs-raw-content">
                    <%- comp.content %>
                </div>
            </section>
            <% }); %>
        </div>
    </main>
</div>

<!-- Floating Toast -->
<div id="cs-toast" class="cs-toast">
    <span id="cs-toast-icon">✅</span>
    <span id="cs-toast-msg">Copied snippet to clipboard!</span>
</div>
</body>
</html>
