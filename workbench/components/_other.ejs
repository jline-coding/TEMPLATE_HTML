<div class="p-component__item">
    <!-- Page Loading Animation (ロード画面アニメーション) -->
    <div class="c-loading" style="position: relative; height: 120px; opacity: 1; pointer-events: all; background: #222; border-radius: 8px; margin-bottom: 20px;">
        <div class="c-loading__inner">
            <div class="c-loading__content">
                <div class="c-loading__item"></div>
                <div class="c-loading__item"></div>
            </div>
        </div>
    </div>
</div>

<div class="p-component__item">
    <!-- Cookie Consent Banner (Cookie 同意バナー GDPR) -->
    <div class="c-cookiewrap" style="position: relative; display: block; border-radius: 8px; border: 1px solid #e2e8f0; background: #fff;">
        <div class="c-cookiewrap__inner">
            <p class="c-cookiewrap__close"><a href="javascript:void(0)" data-gdpr="button">同意する</a></p>
            <p class="c-cookiewrap__txt">当サイトではCookieを使用します。Cookieの使用に関する詳細は「<a href="" class="c-cookiewrap__link">プライバシーポリシー</a>」をご覧ください。</p>
        </div>
    </div>
</div>

<div class="p-component__item">
    <!-- Miscellaneous Custom Components Container (その他のカスタムパーツ設定用エリア) -->
    <div class="c-other-box" style="padding: 24px; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px; text-align: center;">
        <p style="font-size: 14px; color: #64748b; margin: 0;">
            🛠️ <strong>_other.scss / _other.ejs:</strong> Dùng để khai báo và định dạng các component đặc thù khác (loading screen, cookie banner, popup bổ trợ, v.v.) không thuộc các nhóm cơ bản.
        </p>
    </div>
</div>
