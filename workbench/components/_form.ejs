    <input type="file" class="c-file-input">
</div>

<div class="p-component__item">
    <!-- Form Custom File Upload -->
    <div class="c-file js-file">
        <label class="c-file__inner js-file__inner" for="wb_file_01">
            <input type="file" id="wb_file_01" name="file">
            <span class="c-file__content js-file__content">添付する</span>
        </label>
        <span class="c-file__clear js-file-clear">×</span>
    </div>
</div>

