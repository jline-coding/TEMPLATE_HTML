<!--
---
title: "Form Controls"
category: "component"
scss: "_form.scss"
---
-->

<div class="p-component__item">
    <!-- Form Group with Input -->
    <div class="c-form-group">
        <label class="c-form-group__label">
            お名前
            <span class="c-form-req">必須</span>
        </label>
        <input type="text" class="c-input" placeholder="例：山田 太郎" autocomplete="name">
    </div>
</div>

<div class="p-component__item">
    <!-- Form Text Input -->
    <input type="text" class="c-input" placeholder="テキストを入力してください">
</div>

<div class="p-component__item">
    <!-- Form Select Dropdown -->
    <select class="c-select">
        <option value="">選択してください</option>
        <option value="1">サービス導入のご相談</option>
        <option value="2">お見積もり・費用について</option>
        <option value="3">採用・パートナーシップについて</option>
        <option value="4">その他</option>
    </select>
</div>

<div class="p-component__item">
    <!-- Form Textarea -->
    <textarea class="c-textarea" placeholder="お問い合わせ内容をご自由にご入力ください。"></textarea>
</div>

<div class="p-component__item p-component__item--inline-block">
    <!-- Form Checkbox -->
    <label class="c-checkbox">
        <input type="checkbox" name="agree" value="1">
        <span>利用規約に同意する</span>
    </label>
</div>

<div class="p-component__item p-component__item--inline-block">
    <!-- Form Radio Button -->
    <label class="c-radio">
        <input type="radio" name="contact-method" value="email" checked>
        <span>メール連絡を希望</span>
    </label>
</div>

<div class="p-component__item p-component__item--inline-block">
    <!-- Form Required Badge -->
    <span class="c-form-req">必須</span>
</div>

<div class="p-component__item p-component__item--inline-block">
    <!-- Form Optional Badge -->
    <span class="c-form-opt">任意</span>
</div>
