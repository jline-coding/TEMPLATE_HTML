<div class="p-component__item">
    <!-- Button Standard (通常ボタン) -->
    <a href="" class="c-btn">
        <span class="c-btn__content">ボタン</span>
    </a>

    <!-- Button with Arrow (矢印付きボタン) -->
    <a href="" class="c-btn c-btn--arrow">
        <span class="c-btn__content">ボタン</span>
    </a>

    <!-- Button Arrow Center (矢印中央配置ボタン) -->
    <a href="" class="c-btn c-btn--arrow-center">
        <span class="c-btn__content">ボタン</span>
    </a>

    <!-- Button Arrow Between (矢印両端配置ボタン) -->
    <a href="" class="c-btn c-btn--arrow-between">
        <span class="c-btn__content">ボタン</span>
    </a>
</div>
<div class="p-component__item">
    <!-- Button Reverse (反転ボタン 白背景) -->
    <a href="" class="c-btn c-btn--reverse">
        <span class="c-btn__content">ボタン</span>
    </a>

    <!-- Button Reverse with Arrow (反転 矢印付きボタン) -->
    <a href="" class="c-btn c-btn--arrow c-btn--reverse">
        <span class="c-btn__content">ボタン</span>
    </a>

    <!-- Button Reverse Arrow Center (反転 矢印中央配置ボタン) -->
    <a href="" class="c-btn c-btn--arrow-center c-btn--reverse">
        <span class="c-btn__content">ボタン</span>
    </a>

    <!-- Button Reverse Arrow Between (反転 矢印両端配置ボタン) -->
    <a href="" class="c-btn c-btn--arrow-between c-btn--reverse">
        <span class="c-btn__content">ボタン</span>
    </a>

</div>
<div class="p-component__item">
    <!-- Toggle Hamburger (ハンバーガーメニュー ボタン) -->
    <div class="c-toggle" onclick="this.classList.toggle('active')">
        <span class="c-toggle__line"></span>
    </div>

    <!-- Totop Pagetop (トップへ戻るボタン) -->
    <a href="#wrapper" class="c-totop">pagetop</a>
</div>
